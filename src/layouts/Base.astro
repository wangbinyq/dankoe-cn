---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Dan Koe 免费通讯的中文翻译。' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="alternate" hreflang="en" href="https://letters.thedankoe.com" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --paper: #faf7f2;
    --card: #ffffff;
    --ink: #1e1b18;
    --soft: #6b6259;
    --rule: #e6dfd4;
    --accent: #a8442a;
    --accent-soft: #f3e6dd;
    --note: #f1ece4;

    --font: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
      "Noto Sans SC", "Microsoft YaHei", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--accent);
  }

  /* Article body lives in a JSON data file, so its styles are global. */
  .prose {
    max-width: 660px;
    margin: 0 auto;
    padding: 0 20px 90px;
    font-size: 17px;
    line-height: 1.9;
  }

  .prose p {
    margin: 0 0 1.1em;
  }

  .prose h2 {
    font-size: 19px;
    line-height: 1.5;
    margin: 2.2em 0 0.8em;
    padding-left: 13px;
    border-left: 3px solid var(--accent);
  }

  .prose h3 {
    font-size: 16.5px;
    margin: 1.8em 0 0.5em;
  }

  .prose ul,
  .prose ol {
    margin: 0 0 1.2em;
    padding-left: 1.25em;
  }

  .prose li {
    margin-bottom: 0.45em;
  }

  .prose blockquote {
    margin: 1.6em 0;
    padding: 16px 18px;
    background: var(--accent-soft);
    border-radius: 10px;
    font-size: 16px;
    color: #4a3a31;
  }

  .prose blockquote p:last-child {
    margin: 0;
  }

  .prose blockquote cite {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    font-style: normal;
    color: var(--accent);
  }

  .prose strong {
    font-weight: 700;
  }

  .prose em {
    font-style: normal;
    color: var(--accent);
  }

  .prose .note {
    font-size: 14px;
    color: var(--soft);
    background: var(--note);
    border-radius: 8px;
    padding: 10px 14px;
    margin: 1.4em 0;
  }

  .prose .end {
    margin-top: 2.4em;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    font-size: 14px;
    color: var(--soft);
  }

  .prose .end a {
    color: var(--accent);
    text-decoration: none;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #17150f;
      --card: #1e1b15;
      --ink: #eae4da;
      --soft: #a29a90;
      --rule: #332e26;
      --accent: #e08a5f;
      --accent-soft: #2a211a;
      --note: #221d17;
    }

    .prose blockquote {
      color: #d3c6ba;
    }
  }
</style>
